@{
    // Highlight the current section in the side menu
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "";
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Karnel Admin</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Lexend:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="kt-admin">
        @* ===== Side menu ===== *@
        <aside class="kt-admin-side">
            <a class="kt-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <img src="~/favicon.svg" alt="" width="28" height="28" /> <span>Karnel <strong>Admin</strong></span>
            </a>
            <nav aria-label="Admin menu">
                <a class="kt-side-link @Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="kt-side-link @Active("TouristSpots")" asp-area="Admin" asp-controller="TouristSpots" asp-action="Index">Tourist spots</a>
                <a class="kt-side-link @Active("Hotels")" asp-area="Admin" asp-controller="Hotels" asp-action="Index">Hotels</a>
                <a class="kt-side-link @Active("Restaurants")" asp-area="Admin" asp-controller="Restaurants" asp-action="Index">Restaurants</a>
                <a class="kt-side-link @Active("Resorts")" asp-area="Admin" asp-controller="Resorts" asp-action="Index">Resorts</a>
                <a class="kt-side-link @Active("Transports")" asp-area="Admin" asp-controller="Transports" asp-action="Index">Transport routes</a>
                <a class="kt-side-link @Active("Packages")" asp-area="Admin" asp-controller="Packages" asp-action="Index">Packages</a>
                <a class="kt-side-link @Active("Bookings")" asp-area="Admin" asp-controller="Bookings" asp-action="Index">Bookings</a>
                <a class="kt-side-link @Active("Feedbacks")" asp-area="Admin" asp-controller="Feedbacks" asp-action="Index">Feedback</a>
                <a class="kt-side-link" href="/" target="_blank" rel="noopener">View website ↗</a>
            </nav>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="px-3 mt-3">
                <div class="small mb-2 opacity-75">Signed in as @User.Identity?.Name</div>
                <button type="submit" class="btn btn-sm btn-outline-light w-100">Log out</button>
            </form>
        </aside>

        @* ===== Page content with success / error messages from TempData ===== *@
        <main class="kt-admin-main">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success" role="status">@ok</div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger" role="alert">@err</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
