@{
    ViewData["Title"] = "Thank you";
    ViewData["Menu"] = "Contact";
}
@* Confirmation after a booking or feedback (CRS FR-54) *@
<div class="container kt-section">
    <div class="kt-panel text-center py-5">
        <span class="kt-empty-icon" aria-hidden="true">✅</span>
        <h1 class="h3">Sent</h1>
        <div class="alert alert-success d-inline-block mt-2" role="status">@ViewBag.Message</div>
        <p class="mt-3 mb-0">
            <a class="btn btn-primary" href="/">Back to the Home Page</a>
            <a class="btn btn-outline-primary ms-2" asp-controller="Information" asp-action="Index">Keep exploring</a>
        </p>
    </div>
</div>
