@{
    ViewData["Title"] = "Error";
}
@* Shown in production when an unexpected error happens *@
<div class="container kt-section">
    <div class="kt-empty">
        <span class="kt-empty-icon" aria-hidden="true">⚠️</span>
        <h1 class="h3">Something went wrong</h1>
        <p>Please try again in a moment. If it keeps happening, call our hotline.</p>
        <a class="btn btn-primary" href="/">Back to the Home Page</a>
    </div>
</div>
