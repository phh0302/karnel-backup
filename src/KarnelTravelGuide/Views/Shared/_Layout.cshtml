@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // Which menu item to underline: each view sets ViewData["Menu"] (Home, About, Search, Information, Contact)
    var menu = ViewData["Menu"] as string ?? "";
    string Active(string name) => menu == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Karnel Travel Guide</title>
    <meta name="description" content="Karnel Travels: tourist spots, transport, hotels, restaurants and resorts across Viet Nam." />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />

    @* Fonts from the GUI Standards: Lexend for headings, Be Vietnam Pro for text (both support Vietnamese) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Lexend:wght@600;700&display=swap" rel="stylesheet" />

    @* Bootstrap 5 grid and components *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* ===== Header and main menu (CRS FR-02, FR-03) ===== *@
    <header class="kt-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand kt-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/favicon.svg" alt="" width="32" height="32" />
                    <span>Karnel <strong>Travel Guide</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu"
                        aria-controls="mainMenu" aria-expanded="false" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("About")" href="/About">About Us</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Search")" asp-controller="Search" asp-action="Index">Search</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Active("Information")" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Information</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Information" asp-action="Index">All information</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Information" asp-action="TouristSpots">Tourist Spots</a></li>
                                <li><a class="dropdown-item" asp-controller="Information" asp-action="Travel">Travel Information</a></li>
                                <li><a class="dropdown-item" asp-controller="Information" asp-action="Hotels">Hotel Information</a></li>
                                <li><a class="dropdown-item" asp-controller="Information" asp-action="Restaurants">Restaurant Information</a></li>
                                <li><a class="dropdown-item" asp-controller="Information" asp-action="Resorts">Resorts Information</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link @Active("Contact")" asp-controller="Contact" asp-action="Index">Contact Us</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* ===== Page content ===== *@
    <main class="kt-main">
        @RenderBody()
    </main>

    @* ===== Footer: company details read from appsettings.json "Company" ===== *@
    <footer class="kt-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h2 class="kt-footer-title">@Config["Company:Name"]</h2>
                    <p>Transport between cities, tour packages and accommodation at tourist spots across Viet Nam.</p>
                </div>
                <div class="col-6 col-md-3">
                    <h3 class="kt-footer-sub">Explore</h3>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Information" asp-action="TouristSpots">Tourist Spots</a></li>
                        <li><a asp-controller="Information" asp-action="Hotels">Hotels</a></li>
                        <li><a asp-controller="Information" asp-action="Resorts">Resorts</a></li>
                        <li><a asp-controller="Search" asp-action="Advanced">Advanced search</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h3 class="kt-footer-sub">Contact</h3>
                    <ul class="list-unstyled">
                        <li>@Config["Company:Address"]</li>
                        <li>Hotline: @Config["Company:Hotline"]</li>
                        <li>@Config["Company:Email"]</li>
                        <li>@Config["Company:OpeningHours"]</li>
                    </ul>
                </div>
            </div>
            <p class="kt-copy">© @DateTime.Now.Year Karnel Travels · www.karneltravelguide.com</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
