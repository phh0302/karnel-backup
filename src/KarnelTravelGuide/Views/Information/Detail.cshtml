@model DetailViewModel
@{
    // Shared detail page for a spot, hotel, restaurant, resort or package
    ViewData["Title"] = Model.Title;
    ViewData["Menu"] = "Information";
}

<div class="kt-page-head">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Information</a></li>
                <li class="breadcrumb-item"><a asp-action="@Model.SectionAction">@Model.Section</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1>
            @Model.Title
            @if (!string.IsNullOrEmpty(Model.Badge))
            {
                <span class="kt-pill align-middle ms-2">@Model.Badge</span>
            }
        </h1>
        <p class="kt-muted mb-0">
            @Model.Subtitle
            @if (Model.Stars > 0)
            {
                <span class="kt-stars ms-2" aria-label="@Model.Stars stars">@Money.Stars(Model.Stars)</span>
            }
        </p>
    </div>
</div>

<div class="container">
    <section class="kt-section">
        <div class="row g-4">
            <div class="col-lg-7">
                <img class="kt-img kt-detail-img" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.svg" : Model.ImageUrl)" alt="@Model.Title" />
            </div>
            <div class="col-lg-5">
                <div class="kt-panel">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    <dl class="kt-facts">
                        @foreach (var f in Model.Facts)
                        {
                            <dt>@f.Label</dt>
                            <dd>@f.Value</dd>
                        }
                    </dl>
                    @if (Model.BookServiceType != null)
                    {
                        <a class="btn btn-primary w-100 mt-4" asp-controller="Contact" asp-action="Index"
                           asp-route-serviceType="@Model.BookServiceType" asp-route-serviceId="@Model.BookServiceId">Book this @Model.BookServiceType.ToLower()</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary w-100 mt-4" asp-controller="Contact" asp-action="Index">Ask us about a trip here</a>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (Model.Related.Any())
    {
        <section class="kt-section">
            <h2>@Model.RelatedTitle</h2>
            <div class="row g-4 mt-1">
                @foreach (var card in Model.Related)
                {
                    <div class="col-sm-6 col-lg-3"><partial name="_PlaceCard" model="card" /></div>
                }
            </div>
        </section>
    }
</div>
